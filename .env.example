# GEMINI_API_KEY: Required for Gemini AI Cyber Mentor API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OWNER_EMAIL: Verified email address for initial Owner / Super Admin bootstrap on first sign-in.
# Never hardcode passwords or secret master logins.
OWNER_EMAIL="owner@example.com"

# FLAG_HMAC_SECRET: Server-side secret used to hash and verify CTF flags securely.
FLAG_HMAC_SECRET="CHANGE_ME_TO_A_32_BYTE_RANDOM_HEX_SECRET"
